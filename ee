if not game:IsLoaded() then game.Loaded:Wait(); end;
if getgenv().adonis_bypass_loaded then return; end;

local HookService = loadstring(game:HttpGet("https://raw.githubusercontent.com/00lxh/luna_xyz/refs/heads/main/src/utils/HookService.lua"))();
local setthreadidentity = (setthreadidentity or function(identity: number) end);

local checkcaller = (checkcaller or function() return false end);
local cloneref = (cloneref or function(instance: any) return instance end);

local adonisDetected, adonisBypassed = false, false;
local detected_func, kill_func = nil, nil;

local LP = cloneref(game:GetService("Players")).LocalPlayer;
setthreadidentity(2);

for _, __v in getgc(true) do

	if typeof(__v) ~= "table" then continue; end;

	if rawget(__v, "Detected") and typeof(rawget(__v, "Detected")) == "function" then
		adonisDetected = true; detected_func = rawget(__v, "Detected");
	end;

	if rawget(__v, "Kill") and rawget(__v, "Variables") and rawget(__v, "Process") and typeof(rawget(__v, "Kill")) == "function" then
		adonisDetected = true; kill_func = rawget(__v, "Kill");
	end;
end;

if detected_func then

	local detected_func_hook; detected_func_hook = HookService:Hook(detected_func, function(...)
		return true;
	end);
end;

if kill_func then

	local kill_func_hook; kill_func_hook = HookService:Hook(kill_func, function(...)
		return true;
	end);
end;

local debug_info_hook; debug_info_hook = HookService:Hook(getrenv().debug.info, function(...)

	local LevelOrFunc, Info = ...;

	if detected_func and LevelOrFunc == detected_func then adonisBypassed = true; return coroutine.yield(coroutine.running()); end;
	return debug_info_hook(...);
end);

setthreadidentity(7);

local kick_func_hook; kick_func_hook = HookService:NameCallHook(LP, "kick", function(self, ...)

	if adonisBypassed and not checkcaller() then return nil; end;

	warn("Adonis Tried to kick")
	kick_func_hook(self, ...);
end);

getgenv().adonis_bypass_loaded = true;
