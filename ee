task.spawn(function()
    pcall(function()
        setthreadidentity(2)

        local detected, detectedOriginal, kill

        for _, v in getgc(true) do
            if typeof(v) == "table" then
                if not detected then
                    local a = rawget(v, "Detected")
                    if typeof(a) == "function" then
                        detected = a
                    end
                end
                if not kill and rawget(v, "Variables") and rawget(v, "Process") then
                    local b = rawget(v, "Kill")
                    if typeof(b) == "function" then
                        kill = b
                    end
                end
                if detected and kill then
                    break
                end
            end
        end

        if detected then
            detectedOriginal = hookfunction(detected, function()
                return true
            end)
        end

        if kill then
            hookfunction(kill, function() end)
        end

        local realInfo = getrenv().debug.info
        local infoOriginal
        infoOriginal = hookfunction(realInfo, newcclosure(function(f, ...)
            if detected and f == detected and detectedOriginal then
                return infoOriginal(detectedOriginal, ...)
            end
            return infoOriginal(f, ...)
        end))

        setthreadidentity(7)
    end)
end)
